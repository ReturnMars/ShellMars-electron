{
  "name": "shellmars",
  "version": "1.0.0",
  "description": "An Electron application with Vue and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "oxlint --type-aware --vue-plugin",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "chcp 65001 && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "node scripts/postinstall.js",
    "prebuild:unpack": "node scripts/clean-dist.js",
    "build:unpack": "npm run build && electron-builder --dir",
    "prebuild:win": "node scripts/clean-dist.js",
    "clean:force": "powershell -ExecutionPolicy Bypass -File scripts/force-clean.ps1",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@vicons/antd": "^0.13.0",
    "@vicons/ionicons5": "^0.13.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.6.2",
    "pinia": "^3.0.4",
    "source-map-support": "^0.5.21",
    "ssh2": "^1.17.0",
    "unocss": "^66.5.9",
    "vite": "^7.2.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "naive-ui": "^2.43.2",
    "oxlint": "^1.29.0",
    "oxlint-tsgolint": "^0.8.0",
    "prettier": "^3.6.2",
    "sass": "^1.94.2",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^30.0.0",
    "vfonts": "^0.0.3",
    "vue-tsc": "^3.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "overrides": {
    "electron-builder-squirrel-windows": "^26.0.12"
  },
  "volta": {
    "node": "25.2.1"
  }
}
